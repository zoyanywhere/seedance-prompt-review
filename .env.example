OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
POSTGRES_PASSWORD=
SECURE_COOKIES=true
SESSION_HOURS=24
MAX_REVIEW_ROUNDS=3
DEFAULT_REVIEW_BUDGET_USD=5
MODEL_STORYBOARD=claude-opus-5-5
MODEL_DRAFT=gpt-6.1-sol
MODEL_ACTION=gpt-6.1-sol
MODEL_FINAL_VERIFICATION=claude-opus-5-5
MODEL_SUPERVISOR=gpt-6-astra

PREPARATION_BUDGET_USD=5
MODEL_MEDIA_ANALYSIS=gemini-3.8-flash
MODEL_FRAME_CHECK=gpt-6.1-sol
# All review/planning roles use high effort by default; brief intake uses medium.
EFFORT_SUPERVISOR=high
EFFORT_STORYBOARD=high
EFFORT_FINAL_VERIFICATION=high

# Production: compose.production.yaml enforces secure cookies and upload scanning.
APP_DOMAIN=promptlab.zoyanywhere.com
# Set to the actual Traefik IP or its trusted dedicated proxy subnet.
TRUSTED_PROXY_IPS=127.0.0.1
# Local upload scanning is opt-in; production always requires it.
ANTIVIRUS_REQUIRED=false
CLAMD_HOST=clamav
CLAMD_PORT=3310
